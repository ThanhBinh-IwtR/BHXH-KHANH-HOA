# memory (mặc định, không cần Supabase) | supabase (corpus đầy đủ)
LEGAL_REPOSITORY=memory
CORPUS_VERSION=2025-demo-v1
# Chỉ bắt buộc khi LEGAL_REPOSITORY=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
# Tùy chọn cho model reasoning tương thích OpenAI (ví dụ Z.AI GLM):
# LLM_THINKING_MODE=disabled
# LLM_MAX_OUTPUT_TOKENS=1024
# Adapter appends /hf-inference/models/{model} for HF task inference.
EMBEDDING_BASE_URL=https://router.huggingface.co
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_BASE_URL=https://router.huggingface.co
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AI_TIMEOUT_MS=50000
REQUEST_TIMEOUT_MS=60000
# Có thể hạ hai giá trị trên nếu provider/model có latency thấp hơn.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SALT=
# Credential-gated Supabase integration test (both required or the suite skips)
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_PAGE_TIMEOUT_SECONDS=60
OCR_MIN_CONFIDENCE=75.0
